# MongoDB Atlas connection string (M0 free tier is fine).
# Atlas UI: Connect -> Drivers -> copy the string, then replace <password>.
# Include the database name in the path OR set DB_NAME below.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=reel-saves"

# Database name to use inside the cluster.
DB_NAME="reelsaves"

# Per-user API keys as comma-separated "owner:key" pairs. Each user (tenant) gets
# their own key; the key both authenticates the request and identifies whose reels
# they are. Every save is stamped with the owner and only read back by that owner.
# Generate each key with a long random value, e.g.:  openssl rand -hex 32
API_KEYS="fersi:change-me-long-random,sami:another-long-random"
